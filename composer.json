{
    "name": "jacobjoergensen/laravel-paper",
    "description": "A flat-file Eloquent driver for modern Laravel.",
    "license": "MIT",
    "keywords": [
        "laravel",
        "eloquent",
        "flat-file",
        "cms",
        "markdown",
        "frontmatter",
        "content"
    ],
    "authors": [
        {
            "name": "JacobJoergensen",
            "email": "jj@minehubsstudios.com"
        }
    ],
    "homepage": "https://laravel-paper.com",
    "require": {
        "php": "^8.4",
        "composer-runtime-api": "^2.2",
        "illuminate/config": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/filesystem": "^12.0|^13.0",
        "illuminate/pagination": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/translation": "^12.0|^13.0",
        "symfony/yaml": "^7.4.23|^8.1.11"
    },
    "require-dev": {
        "laravel/pint": "^1.32.3",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.7.8",
        "pestphp/pest-plugin-type-coverage": "^4.0.4",
        "phpstan/phpstan": "^2.3.5"
    },
    "autoload": {
        "psr-4": {
            "JacobJoergensen\\LaravelPaper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JacobJoergensen\\LaravelPaper\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "bench": [
            "Composer\\Config::disableProcessTimeout",
            "@php benchmarks/bench.php"
        ],
        "lint": "vendor/bin/pint --parallel",
        "test:lint": "vendor/bin/pint --parallel --test",
        "test:types": "vendor/bin/phpstan analyse",
        "test:type-coverage": "vendor/bin/pest --type-coverage --min=100",
        "test:unit": "vendor/bin/pest",
        "test": [
            "@test:lint",
            "@test:types",
            "@test:type-coverage",
            "@test:unit"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "JacobJoergensen\\LaravelPaper\\PaperServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
