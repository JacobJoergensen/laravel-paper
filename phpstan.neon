parameters:
    level: max
    paths:
        - benchmarks
        - src
        - tests/Fixtures
        - tests/TestCase.php
    tmpDir: build/phpstan
    ignoreErrors:
        # #[Fillable] and #[Hidden] are Laravel 13 only.
        - identifier: attribute.notFound
          path: */tests/Fixtures/Post.php
          reportUnmatched: false
        # Automatic relationship loading only exists on newer Laravel 12.
        - identifier: function.alreadyNarrowedType
          reportUnmatched: false
