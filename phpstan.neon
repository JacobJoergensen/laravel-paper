parameters:
    level: max
    paths:
        - benchmarks
        - src
        - tests/Fixtures
        - tests/TestCase.php
    tmpDir: build/phpstan
    ignoreErrors:
        # #[Fillable] and #[Hidden] are Laravel 13 only.
        - identifier: attribute.notFound
          path: */tests/Fixtures/Post.php
          reportUnmatched: false
        # Model::withoutEvents returns mixed on Laravel 12, it is generic on Laravel 13.
        - message: '#^Method .+::(increment|decrement)(Each)?Quietly\(\) should return int\|false but returns mixed\.$#'
          identifier: return.type
          path: */src/Paper.php
          reportUnmatched: false
        # Automatic relationship loading only exists on newer Laravel 12.
        - identifier: function.alreadyNarrowedType
          path: */src/Paper.php
          reportUnmatched: false
        # ExtendedPost::writer() is untyped on purpose: paperRelations skips it.
        - identifier: missingType.return
          path: */tests/Fixtures/ExtendedPost.php
